# =============================================================================
# PAGE INTERNATIONAL B2B MACHINERY PLATFORM — ENVIRONMENT SPECIFICATION
# =============================================================================

# PostgreSQL 15+ Database Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/page_db

# Alternative Discrete Database Connection Parameters
PGHOST=localhost
PGPORT=5432
PGDATABASE=page_db
PGUSER=postgres
PGPASSWORD=postgres

# Application Application Role (Used for RLS enforcement under non-superuser)
# Role created via db/migrations/0005_app_user_role.sql
PAGE_APP_ROLE=page_app_user

# Node / Nitro Server Environment
NODE_ENV=development
PORT=8080

# Cookie & Session Security Flags (Automatically enabled in production)
# In production, set to true to force Secure and SameSite=Strict cookies
COOKIE_SECURE=false
